[Unit]
Description=DronService video control service
After=network-online.target mediamtx.service
Wants=network-online.target mediamtx.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=admin
Group=admin
SupplementaryGroups=video
ExecStart=/usr/local/bin/dronservice
Environment=MEDIAMTX_URL=http://127.0.0.1:9997
Environment=DRONSERVICE_DATA_DIR=/var/lib/dronservice
Environment=DRONSERVICE_ADDR=:80
Environment=MEDIAMTX_CONFIG_PATH=/usr/local/etc/mediamtx/mediamtx.yml
EnvironmentFile=-/etc/dronservice/update.conf
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
StateDirectory=dronservice
StateDirectoryMode=0750
UMask=0077
SyslogIdentifier=dronservice
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dronservice /usr/local/etc/mediamtx

[Install]
WantedBy=multi-user.target
