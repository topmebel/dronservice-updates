# Site-specific DronService settings.
# Values here override the defaults from dronservice.service.
# This file is preserved across application updates.

# Listen address. Default in the unit is :80.
# DRONSERVICE_ADDR=:8080

# Public HLS URL shown to browsers for stream preview.
# DRONSERVICE_HLS_PUBLIC_URL=http://192.168.1.147:8888

# MediaMTX Control API credentials (optional).
# MEDIAMTX_USER=admin
# MEDIAMTX_PASSWORD=

# MAVLink flight controller (UDP). Per-drone settings can also be stored in
# /var/lib/dronservice/mavlink.json or changed through the HTTP API.
# MAVLINK_ENABLED=true
# MAVLINK_UDP_ADDR=0.0.0.0:14550
# MAVLINK_OUT_SYSTEM_ID=255
# MAVLINK_TARGET_SYSTEM_ID=0
# MAVLINK_LINK_TIMEOUT=5s
# MAVLINK_MESSAGE_INTERVAL=500ms
